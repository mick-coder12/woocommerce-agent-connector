# Copy to .env (git-ignored) and fill in. Leave ALL THREE unset to run in demo mode.
# Create keys in WordPress admin: WooCommerce > Settings > Advanced > REST API > Add key
# -> set Permissions to "Read" (the connector only ever issues GET requests).
WOOCOMMERCE_STORE_URL=https://your-store.example.com
WOOCOMMERCE_CONSUMER_KEY=ck_replace_me
WOOCOMMERCE_CONSUMER_SECRET=cs_replace_me
